# ==============================================================================
# Aura Global E-Menu & Management System - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with your environment details.

# ------------------------------------------------------------------------------
# 1. Backend Server & Application URLs (Private / Server-Side)
# ------------------------------------------------------------------------------
PORT=3000
API_KEY_AUTH=aura_demo_api_key_sample123
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3000/shop/sbc-store

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB - optional; fallback active)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aura_db_user
DB_PASS=aura_db_password_example
DB_PASSWORD=aura_db_password_example
DB_NAME=aura_pos_emenu_db
DB_POOL_LIMIT=10

# ------------------------------------------------------------------------------
# 3. Telegram Bot & Kitchen Dispatch (Private / Server-Side ONLY)
# ------------------------------------------------------------------------------
# Obtained from @BotFather on Telegram. Kept on the server to prevent token theft.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE
TELEGRAM_BOT_USERNAME=aura_emenu_order_bot
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 4. Vite Frontend Public Variables (Safe to expose to browser client)
# ------------------------------------------------------------------------------
# In Vite, only variables prefixed with VITE_ are sent to the user's browser.
# Never expose secrets or bot tokens here.
VITE_API_URL=/api
VITE_BOT_USERNAME=aura_emenu_order_bot
